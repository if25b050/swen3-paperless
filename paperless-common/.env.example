# Example-Dotenv-File for the local-configuration
# this file should not contain with valid values
# copy this file and remove ".example" at the end of the file before adding the required properties

# S3 Properties
S3_URL=http://localhost:9000
S3_BUCKET=paperless
S3_ACCESSKEY=rustfspaperless
S3_SECRETKEY=rustfspaperless
# RabbitMQ  Properties
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=paperlessMQ
RABBITMQ_PASSWORD=paperlessMQ
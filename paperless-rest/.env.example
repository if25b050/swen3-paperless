# Example-Dotenv-File for the local-configuration
# this file should not contain with valid values
# copy this file and remove ".example" at the end of the file before adding the required properties

# DB Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/paperless
DATABASE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DATABASE_PASSWORD=paperless
DATABASE_USERNAME=paperless
# Servlet Configuration
MAX_FILE_SIZE=1MB
MAX_REQUEST_SIZE=1MB

  "item": [
    {
      "name": "Create Document",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "const uuid = response.uuid;",
              "const filename = response.name;",
              "",
              "pm.collectionVariables.set(\"document_uuid\", uuid);",
              "",
              "pm.test(\"Response has uuid and name\", function () {",
              "    pm.expect(uuid).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(filename).to.be.a(\"string\").and.not.empty;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "packages": {},
            "type": "text/javascript"
          }
        }

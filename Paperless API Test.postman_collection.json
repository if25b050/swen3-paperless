    {
      "name": "Get Document File",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Compare the GET response PDF with the hash stored from the POST (Create Document) request\r",
              "pm.test(\"Response content type is PDF\", function () {\r",
              "    pm.response.to.have.header(\"Content-Type\");\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\");\r",
              "});\r",
              "\r",
              "pm.test(\"response has file\", function () {\r",
              "    const rawStream = pm.response.stream;\r",
              "    const uint8Array = new Uint8Array(rawStream);\r",
              "    pm.expect(uint8Array.length).to.be.above(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
